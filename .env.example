# ──────────────────────────────────────────────────────────────────────────
# Hearth — environment configuration
# Copy to .env for local development. docker-compose reads .env automatically.
# Nothing in this file is a secret; fill in your own values and never commit .env.
# ──────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────
# Everything in this section is optional. The public URL, reverse-proxy flag,
# extra MCP hosts and job intervals are set in the app under More → Server;
# values here are the fallback until then. The two keys are generated on first
# start (kept in HEARTH_DATA_DIR, the hearth-data volume) unless you set them.

# Public URL users (and notification links) reach the app at. https → Secure cookies.
APP_URL=
# Host port docker-compose publishes the app on (the container always listens on 3000).
PORT=3000
# Image tag docker-compose pulls: main (default, follows the main branch), latest, sha-<short>, or a version.
HEARTH_TAG=main
# Random string, at least 32 chars. Signs sessions and alert-ack links.
#   openssl rand -base64 48      (leave empty to generate on first start)
APP_SECRET=
# Random string, at least 32 chars. Encrypts secrets at rest (integration keys,
# Plaid tokens, push keys, the Anthropic key). Leave empty to generate on first
# start. Rotating it means re-entering those secrets.
APP_ENCRYPTION_KEY=
# Where generated keys are kept. The image sets /app/data; for `cargo run` the default is ./data.
#HEARTH_DATA_DIR=/app/data
# Set to true when behind a reverse proxy so X-Forwarded-* headers are trusted.
TRUST_PROXY=false
# Host header values the MCP endpoint accepts (comma-separated, DNS-rebinding guard).
# Default: the host of the public URL (with and without port) plus localhost/127.0.0.1.
# Only set this if the app is reached under a hostname that is not in the public URL.
MCP_ALLOWED_HOSTS=
# Log filter (tracing EnvFilter syntax) and format (text | json).
LOG_LEVEL=info,sqlx=warn
LOG_FORMAT=text

# ── Database ──────────────────────────────────────────────────────────────
# The bundled Postgres from docker-compose. Change the password; any characters
# are fine, nothing is URL-encoded.
POSTGRES_USER=hearth
POSTGRES_PASSWORD=hearth
POSTGRES_DB=hearth
# Only for a Postgres that is not the compose `db` service (an external server,
# or `cargo run` against localhost). Overrides the POSTGRES_* values when set.
# A password with @ : / # or % must be percent-encoded in a URL.
#DATABASE_URL=postgres://hearth:hearth@localhost:5432/hearth
#POSTGRES_HOST=db
#POSTGRES_PORT=5432

# ── Jobs ──────────────────────────────────────────────────────────────────
# Set false to run a web-only container (e.g. when a separate worker runs jobs).
JOBS_ENABLED=true
SCHEDULER_TICK_SECONDS=30
# Intervals (minutes); the app's More → Server values override these.
PLAID_SYNC_MINUTES=60
PRIVACY_SYNC_MINUTES=10
EVALUATE_MINUTES=15

# ── Integrations ──────────────────────────────────────────────────────────
# Everything below can be set in the app instead (More → Integrations, More →
# Notifications; owner only, stored encrypted). The environment is a fallback;
# a value saved in the app wins.

# ── Plaid (optional) ──────────────────────────────────────────────────────
# Leave CLIENT_ID and SECRET empty to disable. PLAID_ENV: sandbox | production
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

# ── Privacy.com (optional) ────────────────────────────────────────────────
# Leave empty to disable. PRIVACY_ENV: sandbox | production
PRIVACY_API_KEY=
PRIVACY_ENV=sandbox

# ── Notifications: ntfy (optional) ────────────────────────────────────────
# Leave NTFY_TOPIC empty to disable. Self-hosted ntfy: set NTFY_URL.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# ── Notifications: email over SMTP (optional) ─────────────────────────────
# Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=hearth@example.com
ALERT_EMAIL_TO=you@example.com
